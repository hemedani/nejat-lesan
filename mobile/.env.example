# Copy to a local environment file before running the app.
# This mirrors the frontend's LESAN_URL and is exposed at Expo build time.
#
# Expo loads .env files by NODE_ENV mode (highest priority first):
#   .env.<mode>.local  ->  .env.local  ->  .env.<mode>  ->  .env
# Development mode (`pnpm start`) uses `.env.development`; production
# exports/builds (NODE_ENV=production) use `.env.production`.
#
# Committed defaults:
#   .env.development -> http://localhost:1404
#   .env.production  -> http://46.245.98.207:1400
#
# Machine/device-specific overrides belong in a gitignored `.env.local`
# (or `.env.development.local` / `.env.production.local`), for example:
#   Android emulator: http://10.0.2.2:1404
#   Physical phone:   http://<your-computer-lan-ip>:1404 (for example, 192.168.1.20)
EXPO_PUBLIC_LESAN_URL=http://10.0.2.2:1404
EXPO_PUBLIC_APP_ENV=development
# Turns on the sync worker's upload pipelines: the accident wizard's fixed media
# slots (`file.uploadAccidentImages`) and dynamic-form `file` fields
# (`file.uploadFile`). Leave it off and captures stay on the device only — the
# report is still filed, but the front panel cannot show its assets.
EXPO_PUBLIC_ACCIDENT_UPLOADS=on
#
# Self-hosted vector map style document (lesan/tiles). Required: the map has no
# public fallback, so an unset value fails loudly rather than defaulting to OSM.
# Start the server with `cd tiles && ./run-local.sh` (serves http://localhost:8790).
#   Android emulator:  http://10.0.2.2:8790/style.json   (10.0.2.2 is the host's localhost)
#   Physical phone:    http://<your-computer-lan-ip>:8790/style.json
# A physical device cannot reach `localhost`. When you set a LAN IP, also rebuild the server
# artifacts with `TILES_PUBLIC_ORIGIN=http://<lan-ip>:8790 ./build/gen-artifacts.sh`, or the
# style will load but its tile URLs will point the device at itself.
EXPO_PUBLIC_MAP_STYLE_URL=http://10.0.2.2:8790/style.json
