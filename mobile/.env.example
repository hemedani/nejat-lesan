# Copy to a local environment file before running the app.
# This mirrors the frontend's LESAN_URL and is exposed at Expo build time.
#
# Expo loads .env files by NODE_ENV mode (highest priority first):
#   .env.<mode>.local  ->  .env.local  ->  .env.<mode>  ->  .env
# Development mode (`pnpm start`) uses `.env.development`; production
# exports/builds (NODE_ENV=production) use `.env.production`.
#
# Committed defaults:
#   .env.development -> http://localhost:1404
#   .env.production  -> http://46.245.98.207:1400
#
# Machine/device-specific overrides belong in a gitignored `.env.local`
# (or `.env.development.local` / `.env.production.local`), for example:
#   Android emulator: http://10.0.2.2:1404
#   Physical phone:   http://<your-computer-lan-ip>:1404 (for example, 192.168.1.20)
EXPO_PUBLIC_LESAN_URL=http://10.0.2.2:1404
EXPO_PUBLIC_APP_ENV=development
