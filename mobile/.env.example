# Copy to a local environment file before running the app.
# This mirrors the frontend's LESAN_URL and is exposed at Expo build time.
# Android emulator: http://10.0.2.2:1404
# Physical phone: http://<your-computer-lan-ip>:1404 (for example, 192.168.1.20)
EXPO_PUBLIC_LESAN_URL=http://10.0.2.2:1404
EXPO_PUBLIC_APP_ENV=development