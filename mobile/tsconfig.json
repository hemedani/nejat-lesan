{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@backend/*": [
        "../back/declarations/*"
      ],
      "@forms": [
        "../shared/form-engine/src/index.ts"
      ],
      "@forms/*": [
        "../shared/form-engine/src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../shared/form-engine/src/**/*.ts"
  ]
}