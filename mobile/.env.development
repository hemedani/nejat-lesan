EXPO_PUBLIC_LESAN_URL=http://46.245.98.207:3044
EXPO_PUBLIC_APP_ENV=development
# Enables the upload pipelines in the sync worker (see src/config/env.ts).
# Without it, captured assets stay local and their ids reach the server unresolved.
# `EXPO_PUBLIC_*` is inlined at bundle time — restart the dev server after changing it.
EXPO_PUBLIC_ACCIDENT_UPLOADS=on
