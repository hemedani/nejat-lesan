EXPO_PUBLIC_LESAN_URL=http://46.245.98.207:1400
EXPO_PUBLIC_APP_ENV=development
# Enables the upload pipelines in the sync worker (see src/config/env.ts).
# Without it, captured assets stay local and their ids reach the server unresolved.
# `EXPO_PUBLIC_*` is inlined at bundle time — restart the dev server after changing it.
EXPO_PUBLIC_ACCIDENT_UPLOADS=on
# Self-hosted vector map style (lesan/tiles). Start it with `cd tiles && ./run-local.sh`.
# A physical device cannot reach the host's `localhost`: override this in a gitignored
# `.env.development.local` with the machine's LAN IP, and rebuild the server artifacts with
# `TILES_PUBLIC_ORIGIN=http://<lan-ip>:8790 ./build/gen-artifacts.sh` so the style's tile
# URLs point back at the host rather than at the device.
EXPO_PUBLIC_MAP_STYLE_URL=http://localhost:8790/style.json
