EXPO_PUBLIC_LESAN_URL=http://46.245.98.207:1400
EXPO_PUBLIC_APP_ENV=production
# Required: without this the sync worker skips both upload pipelines entirely
# (`uploadsEnabled === false` in src/config/env.ts) and files the report with the
# local `asset-…` ids still in `dynamic_answers.answer_names`, so the panel shows
# no evidence at all. See .env.example for the full explanation.
EXPO_PUBLIC_ACCIDENT_UPLOADS=on
# Self-hosted vector map style (lesan/tiles). `gen-artifacts.sh` bakes TILES_PUBLIC_ORIGIN
# into `dist/style.json`/`dist/tiles.json`, so the origin here and the origin the server was
# built with must match. HTTPS is required before any public deploy (see tiles/README.md);
# reachability from an Iranian SIM is still unverified.
EXPO_PUBLIC_MAP_STYLE_URL=http://46.245.98.207:8790/style.json
